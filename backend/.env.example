# Oasis Finance — Variables de entorno
# Copiá este archivo como .env y completá los valores

# API Key de Anthropic (requerida para categorización automática)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Base de datos (por defecto usa SQLite local)
DATABASE_URL=sqlite:///./oasis.db

# Entorno
ENVIRONMENT=development
DEBUG=true
